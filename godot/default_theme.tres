[gd_resource type="Theme" load_steps=2 format=3]

[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "PingFang SC", "Heiti SC", "Microsoft YaHei", "SimHei", "WenQuanYi Micro Hei", "sans-serif")
allow_system_fallback = true

[resource]
default_font = SubResource("SystemFont_cjk")
default_font_size = 15
