; 桌面武林 — Godot 4.6 移植
; H5(src/*.js) → 原生 GDScript 重写。combat_core.gd 与 src/combat-core.js 逐行1:1(莱布尼茨可对拍保真)。
config_version=5

[application]
config/name="桌面武林"
config/description="H5 增量武侠 → Godot 4.6 原生移植"
run/main_scene="res://scenes/home.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
CombatCore="*res://scripts/combat_core.gd"

[display]
; 房间图为竖版 3:4(1536×2048),窗口同比例→contain 适配后房间铺满整屏无灰边
window/size/viewport_width=720
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]
theme/custom="res://default_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
