; 桌面武林 — Godot 4.6 移植
; H5(src/*.js) → 原生 GDScript 重写。combat_core.gd 与 src/combat-core.js 逐行1:1(莱布尼茨可对拍保真)。
config_version=5

[application]
config/name="桌面武林"
config/description="H5 增量武侠 → Godot 4.6 原生移植"
run/main_scene="res://scenes/desktop.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
CombatCore="*res://scripts/combat_core.gd"
Player="*res://scripts/player_state.gd"

[display]
; 桌面挂机横条:无边框置顶,运行时由 desktop.gd 设为全屏宽×屏幕高/4 贴底。这里给个横条初值。
window/size/viewport_width=1280
window/size/viewport_height=320
window/size/borderless=true
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/custom="res://default_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
